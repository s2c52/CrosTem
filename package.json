{
  "name": "crostem",
  "version": "1.3.0",
  "private": true,
  "description": "CrosTem — Mac compatibility for Steam (browser extension)",
  "author": "Sacha Gennari (s2c52)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:release": "tsc --noEmit && vite build --mode release",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "node scripts/e2e.mjs",
    "icons": "node scripts/icons.mjs",
    "package": "npm run build:release && node scripts/package.mjs",
    "listing": "node scripts/listing.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.10.6",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
