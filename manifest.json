{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.0.1",
  "description": "__MSG_appDesc__",
  "author": {
    "email": "s2c52@users.noreply.github.com"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://store.steampowered.com/*",
    "https://www.codeweavers.com/*",
    "https://www.applegamingwiki.com/*",
    "https://raw.githubusercontent.com/AreWeAntiCheatYet/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://store.steampowered.com/app/*"],
      "js": ["src/content/app.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://store.steampowered.com/search*"],
      "js": ["src/content/search.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://store.steampowered.com/wishlist*"],
      "js": ["src/content/wishlist.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://store.steampowered.com/*"],
      "js": ["src/content/capsules.ts"],
      "run_at": "document_idle"
    }
  ],
  "default_locale": "en",
  "web_accessible_resources": [
    {
      "resources": ["locales/*.json"],
      "matches": ["https://store.steampowered.com/*"]
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "CrosTem",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
