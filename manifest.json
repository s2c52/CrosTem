{
  "manifest_version": 3,
  "name": "CrosTem — Mac compatibility for Steam",
  "version": "0.4.0",
  "description": "Shows CodeWeavers CrossOver (macOS) compatibility ratings on Steam store pages, capsules, search results and wishlist.",
  "author": {
    "email": "s2c52@users.noreply.github.com"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.codeweavers.com/*",
    "https://www.applegamingwiki.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://store.steampowered.com/app/*"
      ],
      "js": [
        "src/content/app.ts"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.steampowered.com/search*"
      ],
      "js": [
        "src/content/search.ts"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.steampowered.com/wishlist*"
      ],
      "js": [
        "src/content/wishlist.ts"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.steampowered.com/*"
      ],
      "js": [
        "src/content/capsules.ts"
      ],
      "run_at": "document_idle"
    }
  ]
}
