{
  "manifest_version": 3,
  "name": "CrosTem — CrossOver Compatibility for Steam",
  "version": "0.2.0",
  "description": "Shows CodeWeavers CrossOver (macOS) compatibility ratings on Steam store pages, capsules, search results and wishlist.",
  "author": "Sacha Gennari (s2c52)",
  "permissions": ["storage"],
  "host_permissions": ["https://www.codeweavers.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://store.steampowered.com/app/*"],
      "js": [
        "lib/parser.js",
        "lib/matcher.js",
        "lib/cache.js",
        "lib/client.js",
        "lib/widget.js",
        "lib/auto.js",
        "content-app.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://store.steampowered.com/search*"],
      "js": [
        "lib/parser.js",
        "lib/matcher.js",
        "lib/cache.js",
        "lib/client.js",
        "lib/widget.js",
        "lib/auto.js",
        "content-search.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://store.steampowered.com/wishlist*"],
      "js": [
        "lib/parser.js",
        "lib/matcher.js",
        "lib/cache.js",
        "lib/client.js",
        "lib/widget.js",
        "lib/auto.js",
        "content-wishlist.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://store.steampowered.com/*"],
      "js": [
        "lib/parser.js",
        "lib/matcher.js",
        "lib/cache.js",
        "lib/client.js",
        "lib/widget.js",
        "lib/auto.js",
        "content-capsules.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
